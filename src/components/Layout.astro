---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { identity, socials } from '../lib/profile';
import TopBar from './TopBar.astro';
import FooterBar from './FooterBar.astro';
import BootScreen from './BootScreen.astro';

interface Props {
  title?: string;
  description?: string;
  path: string;
  /** emit a Person schema.org block (home + about) */
  person?: boolean;
}

const {
  title = 'Aditya Verma | Systems & Backend Developer, Rust, C & Python',
  description = 'Aditya Verma — systems & backend developer and electronics engineering student from Mumbai. Rust, C, C++, Python for Linux, embedded ESP32 & open source.',
  path,
  person = false,
} = Astro.props as Props;

const site = (Astro.site?.toString().replace(/\/$/, '')) ?? 'https://aditya-verma.me';
const canonical = new URL(path, Astro.site).toString();
const ogImage = `${site}/og.png`;

const socialUrls = socials.map((s) => s.href);
const searchContent = JSON.stringify([
  {
    title: 'Notes',
    items: (
      await getCollection('notes')
    )
      .filter((n) => !n.data.draft)
      .map((n) => ({ label: n.data.title, icon: 'note', href: `/notes/${n.id}/` })),
  },
  {
    title: 'Projects',
    items: (
      await getCollection('projects')
    )
      .sort((a, b) => b.data.stars - a.data.stars)
      .map((p) => ({ label: p.data.title, icon: 'file', href: `/projects/${p.id}/` })),
  },
]).replace(/</g, '\\u003c');
const knowsAbout = [
  'Systems Programming',
  'Backend Development',
  'C',
  'C++',
  'Rust',
  'Python',
  'Linux',
  'Embedded Systems',
  'ESP32',
  'Robotics',
  'Open Source',
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: `${site}/`,
      name: identity.name,
      description: 'Portfolio of Aditya Verma — systems & backend developer. Rust, C, C++, Python. Linux, embedded ESP32, robotics & open source.',
      inLanguage: 'en',
      ...(person ? { publisher: { '@id': `${site}/#person` } } : {}),
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${site}/#website` },
    },
    ...(person
      ? [
          {
            '@type': 'Person',
            '@id': `${site}/#person`,
            name: identity.name,
            alternateName: identity.handle,
            jobTitle: identity.title,
            url: `${site}/`,
            image: ogImage,
            sameAs: socialUrls,
            address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressCountry: 'IN' },
            alumniOf: { '@type': 'CollegeOrUniversity', name: 'Mumbai University' },
            knowsAbout,
          },
        ]
      : []),
  ],
});
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content={identity.name} />
    <link rel="canonical" href={canonical} />

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${identity.name} — ${identity.title} — terminal-flavoured portfolio`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@youngcoder45" />
    <meta name="twitter:creator" content="@youngcoder45" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${identity.name} — ${identity.title}`} />

    <link rel="icon" type="image/png" href="/me.png" />
    <link rel="alternate" type="application/rss+xml" title="aditya · notes" href="/rss.xml" />

    <script type="application/ld+json" set:html={schema} />

    <script is:inline>
      (function () {
        var ids = ['paper','dark','nord','dracula','sunset','dim','synthwave','forest','abyss','retro','cyberpunk','halloween','autumn','coffee'];
        var t = 'dark';
        try {
          var stored = localStorage.getItem('av-theme');
          if (stored && ids.indexOf(stored) !== -1) t = stored;
        } catch (e) {}
        document.documentElement.dataset.theme = t;
        try { if (sessionStorage.getItem('av-booted')) document.documentElement.classList.add('booted'); } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <BootScreen />
    <TopBar path={path} />
    <main>
      <div class="page">
        <slot />
      </div>
    </main>
    <FooterBar />
    <div
      id="cmd-palette"
      class="cmd-palette-overlay"
      role="dialog"
      aria-modal="true"
      aria-label="Command Palette"
    >
      <div class="cmd-palette-modal">
        <div class="cmd-palette-header">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="text"
            id="cmd-palette-input"
            placeholder="Search pages, projects..."
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-label="Search"
            aria-controls="cmd-palette-results"
          />
          <kbd>ESC</kbd>
        </div>
        <div id="cmd-palette-results" class="cmd-palette-results" role="listbox" aria-label="Results"></div>
        <div class="cmd-palette-footer">
          <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
          <span><kbd>↵</kbd> Open</span>
          <span><kbd>ESC</kbd> Close</span>
        </div>
      </div>
    </div>
    <script type="application/json" id="search-content" set:html={searchContent} />
    <script>
      import '../scripts/theme.ts';
      import { initCommandPalette } from '../scripts/palette.ts';
      initCommandPalette();
    </script>
  </body>
</html>

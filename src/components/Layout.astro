---
import '../styles/global.css';
import { identity } from '../lib/profile';
import TopBar from './TopBar.astro';
import FooterBar from './FooterBar.astro';
import BootScreen from './BootScreen.astro';

interface Props {
  title?: string;
  description?: string;
  path: string;
}

const {
  title = `${identity.name} — ${identity.title}`,
  description = `Systems & backend developer. C, C++, Rust, Python. Linux, embedded, ESP32, robotics & open source.`,
  path,
} = Astro.props as Props;

const canonical = new URL(path, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="aditya · notes" href="/rss.xml" />

    <script is:inline>
      (function () {
        var ids = ['paper','dark','nord','dracula','lofi','sunset','dim','synthwave','forest','abyss','retro','cyberpunk','halloween','autumn','coffee','garden','business','winter'];
        var t = 'dark';
        try {
          var stored = localStorage.getItem('av-theme');
          if (stored && ids.indexOf(stored) !== -1) t = stored;
        } catch (e) {}
        document.documentElement.dataset.theme = t;
        try { if (sessionStorage.getItem('av-booted')) document.documentElement.classList.add('booted'); } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <BootScreen />
    <TopBar path={path} />
    <main>
      <div class="page">
        <slot />
      </div>
    </main>
    <FooterBar />
    <div
      id="cmd-palette"
      class="cmd-palette-overlay"
      role="dialog"
      aria-modal="true"
      aria-label="Command Palette"
    >
      <div class="cmd-palette-modal">
        <div class="cmd-palette-header">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="text"
            id="cmd-palette-input"
            placeholder="Search pages, projects..."
            autocomplete="off"
            spellcheck="false"
            aria-label="Search"
            aria-controls="cmd-palette-results"
          />
          <kbd>ESC</kbd>
        </div>
        <div id="cmd-palette-results" class="cmd-palette-results" role="listbox" aria-label="Results"></div>
        <div class="cmd-palette-footer">
          <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
          <span><kbd>↵</kbd> Open</span>
          <span><kbd>ESC</kbd> Close</span>
        </div>
      </div>
    </div>
    <script>
      import '../scripts/theme.ts';
      import { initCommandPalette } from '../scripts/palette.ts';
      initCommandPalette();
    </script>
  </body>
</html>
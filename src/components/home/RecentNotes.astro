---
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import NoteRow from '../NoteRow.astro';
import type { PortfolioSection } from '../../data/sections';

interface Props {
  section: PortfolioSection;
}

const { section } = Astro.props as Props;

const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<Section id={section.id} index={section.index} title={section.title} path={section.path}>
  <div class="win" style="padding:.2rem 1rem">
    <ul style="list-style:none;margin:0;padding:0">
      {notes.map((n) => <NoteRow note={n} />)}
    </ul>
  </div>
  <p style="margin-top:1rem;font-size:.82rem;color:var(--fg-dim)">
    <a href="/notes/">&gt;_ cat ./notes --all</a> — more field notes, rants and postmortems.
  </p>
</Section>

---
import Section from '../Section.astro';
import { identity, socials } from '../../lib/profile';
import type { PortfolioSection } from '../../data/sections';

interface Props {
  section: PortfolioSection;
}

const { section } = Astro.props as Props;
---

<Section id={section.id} index={section.index} title={section.title} path={section.path}>
  <a class="community-card" href={identity.discord} target="_blank" rel="noopener noreferrer">
    <span class="community-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
        <path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.3.6a18.3 18.3 0 0 0-6.2 0L8.6 3a19.8 19.8 0 0 0-4.9 1.4C.6 9 -.1 13.5.2 18a20 20 0 0 0 6 3l.8-1.3c-.7-.3-1.4-.6-2-1l.5-.4a14.3 14.3 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l.8 1.3a20 20 0 0 0 6-3c.4-5.2-.7-9.6-2.7-13.6zM8.3 15c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2zm7.4 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2z"></path>
      </svg>
    </span>
    <span class="community-text">
      <span class="community-title">Join my Community</span>
      <span class="community-sub">Discord server - ship code, break things, help each other out.</span>
    </span>
    <span class="arrow">↗ accept invite</span>
  </a>
  <div class="link-grid">
    {
      socials.map((s) => (
        <a class="link-cell" href={s.href} target="_blank" rel="noopener noreferrer">
          <span class="ln">{s.label}</span>
          <span class="pv">{s.hint}</span>
          <span class="arrow">↗ Open Link</span>
        </a>
      ))
    }
  </div>
  <p style="margin-top:1.2rem;font-size:.8rem;color:var(--fg-dim)">
    &gt;_ open for: systems &amp; embedded internships · FOSS collabs · “help i bricked my ESP32” –
    reach me via <a href={identity.issues} target="_blank" rel="noopener noreferrer">github issues</a> or the
    <a href="https://github.com/TheCodeVerseHub" target="_blank" rel="noopener noreferrer">CodeVerseHub</a> community.
    Replies land in the inbox interrupt queue (usually &lt; 24h).
  </p>
</Section>

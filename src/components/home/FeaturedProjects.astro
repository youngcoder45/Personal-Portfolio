---
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import ProjectCard from '../ProjectCard.astro';
import type { PortfolioSection } from '../../data/sections';
import { byStars } from '../../lib/projects';
import { loadGitHubData, fetchedOn } from '../../lib/github';

interface Props {
  section: PortfolioSection;
}

const { section } = Astro.props as Props;

const all = await getCollection('projects');
// The homepage grid always shows at least six projects: featured first, then
// the most-starred remainder, never dropping below six while write-ups exist.
const featured = all
  .filter((project) => project.data.featured)
  .sort(byStars);
const rest = all
  .filter((project) => !project.data.featured)
  .sort(byStars);
const sixUp = [...featured, ...rest].slice(0, Math.max(6, Math.min(featured.length, all.length)));
const writeUps = all.length;
const gh = await loadGitHubData();
const starsAsOf = fetchedOn(gh);
---

<Section id={section.id} index={section.index} title={section.title} path={section.path}>
  <div class="card-grid card-grid--three">
    {
      sixUp.map((project) => (
        <ProjectCard project={project} liveStars={gh?.repoStars} starsAsOf={starsAsOf} />
      ))
    }
  </div>
  <div class="sec-cta">
    <a class="btn primary" href="/projects/">
      <span class="prompt" aria-hidden="true">❯</span> open the project explorer
    </a>
    <span class="sec-cta-note">
      {writeUps} write-ups — filter by stack, year, status, or featured
    </span>
  </div>
</Section>

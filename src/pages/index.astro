---
import Layout from '../components/Layout.astro';
import Term from '../components/Term.astro';
import SectionRail from '../components/SectionRail.astro';
import MobileSectionIndex from '../components/MobileSectionIndex.astro';
import ManPage from '../components/home/ManPage.astro';
import Toolchain from '../components/home/Toolchain.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import RecentNotes from '../components/home/RecentNotes.astro';
import Environment from '../components/home/Environment.astro';
import Contact from '../components/home/Contact.astro';
import GitHub from '../components/home/GitHub.astro';
import { enabledSections, type SectionId } from '../data/sections';
import { identity, tagline } from '../lib/profile';

const sectionComponents: Record<SectionId, typeof ManPage> = {
  about: ManPage,
  toolchain: Toolchain,
  projects: FeaturedProjects,
  notes: RecentNotes,
  environment: Environment,
  github: GitHub,
  contact: Contact,
};
---

<Layout path="/" person>
  <SectionRail />

  <!-- ============ hero ============ -->
  <header class="hero" id="boot">
    <section class="hero-label">boot /dev/aditya · systems-first</section>

    <h1 class="hero-title">
      Aditya <span class="ac">Verma</span>
    </h1>
    <p class="hero-sub">
      <b>{identity.title}</b> — lives at the boundary between <b>software and silicon</b>.
      Writes <b>C</b>, <b>C++</b>, <b>Rust</b> and <b>Python</b>. Tinkerers with ESP32s,
      Arduinos and Raspberry Pis. Breathes Linux. Maintains
      <a href="https://github.com/TheCodeVerseHub" target="_blank" rel="noopener noreferrer">@TheCodeVerseHub</a>.
    </p>
    <div class="hero-cta">
      <a class="btn primary" href="#projects">ls ./projects</a>
      <a class="btn" href={identity.discord} target="_blank" rel="noopener noreferrer">Join My community</a>
      <a class="btn" href={`https://github.com/${identity.handle}`} target="_blank" rel="noopener noreferrer">github.com/{identity.handle}</a>
    </div>
    <div class="rail" aria-hidden="true">
      {tagline.map((t, i) => (
        <span class="r"><b>{t}</b>{i < tagline.length - 1 ? ' ·' : ''}</span>
      ))}
    </div>
  </header>

  <MobileSectionIndex />

  {
    enabledSections.map((section) => {
      const SectionComponent = sectionComponents[section.id];
      return <SectionComponent section={section} />;
    })
  }

  <Term />
</Layout>

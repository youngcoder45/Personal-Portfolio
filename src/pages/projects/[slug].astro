---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { stackLabels } from '../../data/skills';
import { cloneCommand, relatedProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props as Props;
const { Content } = await render(project);
const { data } = project;
const cat = stackLabels[data.category];
const metaTitle = `${data.title} — Aditya Verma`.length <= 62
  ? `${data.title} — Aditya Verma`
  : data.title;

const related = relatedProjects(project, await getCollection('projects'));
const clone = cloneCommand(project);
const statusLabel: Record<string, string> = {
  active: 'active',
  maintained: 'maintained',
  experimental: 'experimental',
  archived: 'archived',
};
---

<Layout path={`/projects/${project.id}/`} title={metaTitle} description={data.blurb} progress>
  <nav class="crumb" aria-label="breadcrumb">
    <a href="/">~</a>
    <span>/</span>
    <a href="/projects/" data-projects-back>projects</a>
    <span>/</span>
    <span class="cw">{project.id}</span>
  </nav>

  <div class="win" style="margin-bottom:1.6rem">
    <div class="win-bar">
      <span class="dot r" aria-hidden="true"></span>
      <span class="dot a" aria-hidden="true"></span>
      <span class="dot g" aria-hidden="true"></span>
      <span class="title">README.md · {data.language}</span>
      <span class="meta">
        {data.org ? 'org: TheCodeVerseHub' : 'personal'}
        <span class="pstat" data-status={data.status}>
          <span aria-hidden="true">·</span> {statusLabel[data.status]}
        </span>
      </span>
    </div>
    <div style="padding:1.1rem 1.3rem">
      <h1 style="margin:0 0 .3rem;font-size:1.6rem;color:var(--fg-strong)">&gt;_ {data.title}</h1>
      <p style="color:var(--fg-dim);margin:0 0 .9rem;font-size:.9rem">{data.blurb}</p>
      <div class="tags" style="display:flex;flex-wrap:wrap;gap:.35rem">
        <span class="tag" data-cat={data.category}>{cat}</span>
        {data.tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
    </div>
  </div>

  <div class="project-layout">
    <article class="prose">
      <Content />
    </article>

    <aside class="p-side" aria-label="Project metadata">
      <div class="win p-side-card">
        <div class="win-bar">
          <span class="title">info — `stat`</span>
        </div>
        <div class="p-side-body">
          <dl>
            <dt class="k">language</dt><dd class="v">{data.language}</dd>
            <dt class="k">year</dt><dd class="v">{data.year}</dd>
            <dt class="k">stars</dt>
            <dd class="v"><span title="star count, curated manually"><span aria-hidden="true">★</span> {data.stars}</span></dd>
            <dt class="k">stack</dt><dd class="v">{data.stack.join(', ')}</dd>
            <dt class="k">status</dt>
            <dd class="v"><span class="pstat" data-status={data.status}>{statusLabel[data.status]}</span></dd>
            { data.org && <><dt class="k">org</dt><dd class="v"><a href="https://github.com/TheCodeVerseHub" target="_blank" rel="noopener noreferrer">TheCodeVerseHub ↗</a></dd></> }
          </dl>

          <div class="clone-block">
            <code class="clone-cmd">{clone}</code>
            <button
              type="button"
              class="copy-btn"
              data-copy={clone}
              aria-describedby="clone-hint"
            >
              <span data-copy-label>copy</span>
            </button>
            <span class="sr-only" role="status" data-copy-status></span>
          </div>
          <p id="clone-hint" class="p-hint"># copy the clone command</p>

          <a class="btn" style="width:100%;justify-content:center;margin-top:.7rem" href={data.repo} target="_blank" rel="noopener noreferrer">
            open repo <span aria-hidden="true">↗</span>
          </a>
          {data.demo && (
            <a class="btn" style="width:100%;justify-content:center;margin-top:.5rem" href={data.demo} target="_blank" rel="noopener noreferrer">
              live demo <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
      <p class="p-note">
        // star counts are curated manually; live GitHub sync is planned.
      </p>
    </aside>
  </div>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <h2 class="related-head" id="related-heading">
          <span class="underline">┬</span> related — <code>grep -l</code>
        </h2>
        <ul class="related-list">
          {related.map((item) => (
            <li>
              <a class="related-link" href={`/projects/${item.id}/`}>
                <span class="related-title">{item.data.title}</span>
                <span class="related-meta">
                  {item.data.category} · {item.data.year} ·
                  <span class="gn"><span aria-hidden="true">★</span> {item.data.stars}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="back-row">
    <a href="/projects/" data-projects-back>&lt; cd .. — back to projects</a>
  </p>
</Layout>

<script>
  import '../../scripts/copy';
  import '../../scripts/back-filter';
</script>

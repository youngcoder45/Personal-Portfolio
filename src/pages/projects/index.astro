---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Section from '../../components/Section.astro';
import ProjectExplorer from '../../components/ProjectExplorer.astro';
import { byStars } from '../../lib/projects';
import { githubStats } from '../../lib/profile';

const projects: CollectionEntry<'projects'>[] = (await getCollection('projects')).sort(byStars);

const writeUpCount = projects.length;
const repoCountLabel = `${githubStats.publicRepos} public repos · ${writeUpCount} write-ups`;
---

<Layout path="/projects" title="~/projects — Aditya Verma" description="Systems, embedded, backend and open-source projects by Aditya Verma — Rust, C/C++, Python, ESP32, Linux tooling and FOSS software.">
  <nav class="crumb" aria-label="breadcrumb">
    <a href="/">~</a>
    <span>/</span>
    <span class="cw">projects</span>
  </nav>

  <h1 class="sr-only">~/projects — Aditya Verma</h1>

  <Section index="01" title="projects" path={`~/projects — ${repoCountLabel}`}>
    <p style="color:var(--fg-dim);font-size:.86rem;margin-top:-.4rem;margin-bottom:1.4rem">
      <code style="color:var(--green)">find ~/projects -name '*.mdx' -print</code>
      — systems, hardware, backend and FOSS. Web stuff lives at the back of this
      directory for a reason.
    </p>

    <ProjectExplorer projects={projects} />
  </Section>

  <p
    style="font-size:.78rem;color:var(--fg-faint);margin-top:2.5rem"
    title={`${githubStats.publicRepos} public repositories as of ${githubStats.asOf}`}
  >
    the full {githubStats.publicRepos}-public-repo tree lives on
    <a href="https://github.com/youngcoder45" target="_blank" rel="noopener noreferrer">github.com/youngcoder45</a>.
  </p>
</Layout>
